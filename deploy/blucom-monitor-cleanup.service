[Unit]
Description=Close abandoned Blucom call monitoring sessions
After=network.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/html/blucom-deploy/current
ExecStart=/usr/bin/php artisan voip:reconcile-monitoring
TimeoutStartSec=120
UMask=0007
NoNewPrivileges=true
